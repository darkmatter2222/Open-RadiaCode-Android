<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape Isotope: Controls on left, chart fills right -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pro_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Isotope panel - horizontal layout in landscape -->
        <LinearLayout
            android:id="@+id/isotopePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Header row with controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/isotopeChartTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ISOTOPE IDENTIFICATION"
                    android:textColor="@color/pro_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/isotopeAccumulationModeToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="3dp"
                    android:text="FULL"
                    android:textColor="@color/pro_magenta"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/chip_outline_background" />

                <TextView
                    android:id="@+id/isotopeDisplayModeToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="3dp"
                    android:text="PROB"
                    android:textColor="@color/pro_cyan"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/chip_outline_background" />

                <TextView
                    android:id="@+id/isotopeHideBackgroundToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="3dp"
                    android:text="BKG"
                    android:textColor="@color/pro_text_muted"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/chip_outline_background" />

                <ImageButton
                    android:id="@+id/isotopeChartTypeBtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_chart_line"
                    android:contentDescription="Chart type"
                    android:scaleType="centerInside"
                    android:padding="3dp"
                    app:tint="@color/pro_text_muted" />

                <ImageButton
                    android:id="@+id/isotopeSettingsBtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="Isotope settings"
                    android:scaleType="centerInside"
                    android:padding="3dp"
                    app:tint="@color/pro_text_muted" />
            </LinearLayout>

            <!-- Mode row: Scan + Realtime + Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/isotopeScanBtn"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="SCAN"
                    android:textSize="10sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/pro_cyan"
                    android:textColor="@color/pro_cyan" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/isotopeRealtimeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Real-time"
                    android:textColor="@color/pro_text_secondary"
                    android:textSize="11sp"
                    app:thumbTint="@color/pro_cyan"
                    app:trackTint="@color/pro_border" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/isotopeStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Idle"
                    android:textColor="@color/pro_text_muted"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Chart + Results - landscape uses shorter container -->
            <FrameLayout
                android:id="@+id/isotopeChartContainer"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="6dp">

                <com.radiacode.ble.ui.IsotopeChartView
                    android:id="@+id/isotopeMultiLineChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible" />

                <com.radiacode.ble.ui.StackedAreaChartView
                    android:id="@+id/isotopeStackedChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <com.radiacode.ble.ui.IsotopeBarChartView
                    android:id="@+id/isotopeBarChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/isotopeScanResultContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/isotopeScanResultText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Press SCAN to identify isotopes"
                        android:textColor="@color/pro_text_muted"
                        android:textSize="12sp"
                        android:gravity="center" />

                    <ProgressBar
                        android:id="@+id/isotopeScanProgress"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="6dp"
                        android:visibility="gone"
                        android:indeterminateTint="@color/pro_cyan" />
                </LinearLayout>
            </FrameLayout>

            <!-- Top isotope quick view -->
            <LinearLayout
                android:id="@+id/isotopeQuickView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOP:"
                    android:textColor="@color/pro_text_muted"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/isotopeTopResult"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="---"
                    android:textColor="@color/pro_cyan"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Intelligence Report Card -->
        <LinearLayout
            android:id="@+id/intelligenceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="INTELLIGENCE REPORT"
                    android:textColor="@color/pro_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <ImageView
                    android:id="@+id/intelligenceInfoButton"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    android:src="@android:drawable/ic_dialog_info"
                    android:tint="@color/pro_text_muted"
                    android:contentDescription="Help"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="2dp" />

                <TextView
                    android:id="@+id/intelligenceAlertBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_background"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="0"
                    android:textColor="@color/pro_background"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/stabilityIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STABLE"
                    android:textColor="@color/pro_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="10dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/pro_border" />

                <TextView
                    android:id="@+id/dataQualityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good (50 samples)"
                    android:textColor="@color/pro_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/intelligenceSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Analyzing data..."
                android:textColor="@color/pro_text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />

            <!-- Metrics Row - landscape: all 3 columns in a row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dose Trend"
                        android:textColor="@color/pro_text_muted"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/doseTrendLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="---"
                        android:textColor="@color/pro_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Predicted Next"
                        android:textColor="@color/pro_text_muted"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/predictedDoseLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="---"
                        android:textColor="@color/pro_text_primary"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/predictionConfidenceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="---"
                        android:textColor="@color/pro_text_muted"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anomalies"
                        android:textColor="@color/pro_text_muted"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/anomalyCountLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="@color/pro_green"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/anomalyDetailLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="none"
                        android:textColor="@color/pro_text_muted"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Expand / Collapse Row -->
            <LinearLayout
                android:id="@+id/intelligenceExpandButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/intelligenceExpandText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Show Statistics"
                    android:textColor="@color/pro_text_muted"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/intelligenceExpandArrow"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@android:drawable/arrow_down_float"
                    android:tint="@color/pro_text_muted"
                    android:contentDescription="Expand" />
            </LinearLayout>

            <!-- Expanded Stats Section -->
            <LinearLayout
                android:id="@+id/intelligenceExpandedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="3dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Range" android:textColor="@color/pro_text_muted" android:textSize="9sp" />
                    <TextView android:id="@+id/statsRangeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="@color/pro_text_secondary" android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="3dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Std Dev" android:textColor="@color/pro_text_muted" android:textSize="9sp" />
                    <TextView android:id="@+id/statsStdDevLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="@color/pro_text_secondary" android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="3dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CV" android:textColor="@color/pro_text_muted" android:textSize="9sp" />
                    <TextView android:id="@+id/statsCvLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="@color/pro_text_secondary" android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="3dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Background" android:textColor="@color/pro_text_muted" android:textSize="9sp" />
                    <TextView android:id="@+id/statsBackgroundLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="@color/pro_text_secondary" android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="3dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="vs Background" android:textColor="@color/pro_text_muted" android:textSize="9sp" />
                    <TextView android:id="@+id/statsVsBackgroundLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="@color/pro_text_secondary" android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Z-Score" android:textColor="@color/pro_text_muted" android:textSize="9sp" />
                    <TextView android:id="@+id/statsZScoreLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="@color/pro_text_secondary" android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
