<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pro_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/pro_surface"
        app:title="Settings"
        app:titleTextColor="@color/pro_text_primary"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/pro_text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ═══ General ═══ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GENERAL"
                android:textColor="@color/pro_cyan"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <!-- Display Units -->
            <LinearLayout
                android:id="@+id/rowUnits"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Display Units" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dose rate and count rate units" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/pro_text_muted" />
            </LinearLayout>

            <!-- Notifications -->
            <LinearLayout
                android:id="@+id/rowNotifications"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Notifications" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Notification style and content" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/pro_text_muted" />
            </LinearLayout>

            <!-- ═══ Dashboard ═══ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DASHBOARD"
                android:textColor="@color/pro_cyan"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp" />

            <!-- Smart Alerts -->
            <LinearLayout
                android:id="@+id/rowAlerts"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Smart Alerts" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Threshold-based and anomaly alerts" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/pro_text_muted" />
            </LinearLayout>

            <!-- Sound & Geiger -->
            <LinearLayout
                android:id="@+id/rowSound"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sound &amp; Geiger" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Audio tick and alert sounds" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/pro_text_muted" />
            </LinearLayout>

            <!-- VEGA Intelligence -->
            <LinearLayout
                android:id="@+id/rowIntelligence"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="VEGA Intelligence" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Statistical analysis and forecasting" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/pro_text_muted" />
            </LinearLayout>

            <!-- Spectrogram -->
            <LinearLayout
                android:id="@+id/rowSpectrogram"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Spectrogram" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Spectrum waterfall display" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/pro_text_muted" />
            </LinearLayout>

            <!-- ═══ Home Screen ═══ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HOME SCREEN"
                android:textColor="@color/pro_cyan"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp" />

            <!-- Widgets -->
            <LinearLayout
                android:id="@+id/rowWidgets"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Widgets" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Home screen widget gallery" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/pro_text_muted" />
            </LinearLayout>

            <!-- ═══ Support ═══ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SUPPORT"
                android:textColor="@color/pro_cyan"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp" />

            <!-- Help Center -->
            <LinearLayout
                android:id="@+id/rowHelp"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Help Center" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Guides, FAQ, and support" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/pro_text_muted" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
