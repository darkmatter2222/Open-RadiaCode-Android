# =============================================================================
# Root .gitignore for RadiaCode Data Collection Monorepo
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
.venv*/
venv/
env/
ENV/

# Testing
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Android / Gradle
# -----------------------------------------------------------------------------
*.iml
.gradle/
local.properties
.idea/
*.apk
!android_app/Installer/*.apk
*.ap_
*.aab
*.dex
bin/
gen/
out/
release/

# Android build outputs (keep in subfolders)
# android_app/app/build/ is already gitignored by android_app/.gitignore

# -----------------------------------------------------------------------------
# IDE / Editor
# -----------------------------------------------------------------------------
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# VS Code (keep .vscode/settings.json if desired)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# -----------------------------------------------------------------------------
# Environment & Secrets
# -----------------------------------------------------------------------------
.env
.env.local
.env.production
.env.*
!.env.example

# SSH / Credentials
*.pem
*.key
id_rsa*
secrets/
credentials/

# -----------------------------------------------------------------------------
# OS Generated
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
docker-compose.override.yml

# -----------------------------------------------------------------------------
# Generated / Large Files
# -----------------------------------------------------------------------------
*.wav
*.mp3
*.bin
*.pt
*.pth
*.onnx
*.safetensors

# Exclude large model files (they should be downloaded or mounted)
# Uncomment if models should not be committed:
# models/
# *.pt
# *.pth

# Training data (generated, not committed)
data/synthetic/
data/raw/

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.bak
*.tmp
*.temp
.cache/
.tmp/
node_modules/
