# Vega Bulk Binomial Detection Service Environment Configuration
# Copy to .env and fill in your values

# SSH connection
SSH_USER=your_username
SSH_HOST=your_server
SSH_KEY_PATH=~/.ssh/your_key
REMOTE_PATH=/opt/vega/binomial

# API configuration  
API_PORT=8021

# Model source directory (local)
LOCAL_MODELS_DIR=../../vega_ml/models/binary_isotope_v5_micro_2000per
